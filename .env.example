# Copy to .env and add your own API keys. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key
BACKBOARD_API_KEY=your_backboard_api_key

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite  # comma-separated, used when the main model is busy
# BACKBOARD_GEMINI_MODEL=your_backboard_supported_google_model  # must be a model id Backboard lists for provider "google"
# PORT=8787
