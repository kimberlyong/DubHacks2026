# Copy to .env and add your own API keys. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key
BACKBOARD_API_KEY=your_backboard_api_key

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite  # comma-separated, used when the main model is busy
# BACKBOARD_GEMINI_MODEL=your_backboard_supported_google_model  # must be a model id Backboard lists for provider "google"
# PORT=8787

# Optional: Google Calendar sign-in. Create an OAuth "Web application" client in
# Google Cloud Console (APIs & Services > Credentials), enable the Google Calendar API,
# and add http://127.0.0.1:5173 and http://localhost:5173 as Authorized JavaScript origins.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
